{
  "name": "fork-version",
  "version": "6.3.1",
  "license": "MIT",
  "description": "Fork-Version automates version control tasks such as determining, updating, and committing versions, files, and changelogs, simplifying the process when adhering to the conventional commit standard.",
  "keywords": [
    "changelog",
    "commit",
    "conventional changelog",
    "conventional commits",
    "git",
    "metadata",
    "semantic version",
    "semantic",
    "semver",
    "tag",
    "version"
  ],
  "homepage": "https://github.com/eglavin/fork-version",
  "bugs": {
    "url": "https://github.com/eglavin/fork-version/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eglavin/fork-version.git"
  },
  "author": {
    "name": "Eanna Glavin",
    "url": "https://eglavin.com"
  },
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=22.4.0"
  },
  "private": false,
  "type": "module",
  "types": "dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./cli": "./dist/cli.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "fork-version": "./dist/cli.js"
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "README.md"
  ],
  "scripts": {
    "fork-version": "node dist/cli.js",
    "dev": "tsdown --watch",
    "build": "tsdown",
    "update-json-schema": "node scripts/update-json-schema.ts",
    "lint": "oxlint --fix src",
    "lint:check": "oxlint src",
    "format": "oxfmt src",
    "format:check": "oxfmt --check src",
    "typecheck": "tsc --noEmit",
    "check": "tsc --noEmit && oxlint src && oxfmt --check src",
    "test": "vitest",
    "test:cover": "vitest --coverage",
    "test:ci": "vitest run --coverage --no-file-parallelism",
    "test:ui": "vitest --ui",
    "test:cleanup": "rimraf -g ../fork-version.tests/*"
  },
  "dependencies": {
    "domhandler": "6.0.1",
    "handlebars": "4.7.10",
    "htmlparser2": "12.0.0",
    "jiti": "2.7.0",
    "jsonc-parser": "3.3.1",
    "semver": "7.8.5",
    "yaml": "2.9.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "0.18.5",
    "@types/node": "24.11.0",
    "@types/semver": "7.8.0",
    "@vitest/coverage-v8": "5.0.4",
    "@vitest/ui": "5.0.4",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "oxlint-tsgolint": "7.0.2004",
    "publint": "0.3.25",
    "rimraf": "6.1.3",
    "tsdown": "0.23.1",
    "typescript": "7.0.2",
    "vitest": "5.0.4"
  }
}
